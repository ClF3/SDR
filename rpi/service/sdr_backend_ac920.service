[Unit]
Description=SDR Raspberry Pi WebSDR backend for AC920 hardware
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/pi/SDR
Environment=PYTHONPATH=/home/pi/SDR:/home/pi/SDR/rpi/backend
ExecStart=/home/pi/SDR/.venv/bin/python -m sdr_backend --config rpi/backend/config/ac920_hardware.yaml
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
